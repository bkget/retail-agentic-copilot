# ==========================================
# Retail Agentic Copilot - Environment Config
# ==========================================

# Database Configuration
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
POSTGRES_AGENT_PASSWORD=change-me-agent
POSTGRES_REFRESHER_PASSWORD=change-me-refresher
POSTGRES_HOST=retail_copilot_db
POSTGRES_INTERNAL_PORT=5432
POSTGRES_HOST_PORT=5433

# Backend & Agent Configuration
BACKEND_HOST_PORT=8000
LLM_PROVIDER=mock
# To use Gemini, set LLM_PROVIDER=gemini and provide your API key:
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
CORS_ALLOW_ORIGINS=["http://localhost:3000"]
SESSION_TTL_SECONDS=1800
# memory | redis   (redis: `docker compose --profile redis up -d`)
SESSION_BACKEND=memory

# Optional FREE LLM fallback for phrasings the rule engine doesn't know.
# It only rewrites the question; SQL + numbers stay deterministic and guardrailed.
#   Ollama (local, no key):  NLU_BASE_URL=http://host.docker.internal:11434/v1  NLU_MODEL=qwen2.5:3b
#   Groq free tier:          NLU_BASE_URL=https://api.groq.com/openai/v1         NLU_MODEL=llama-3.1-8b-instant
#   Gemini free tier:        NLU_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  NLU_MODEL=gemini-flash-lite-latest
NLU_FALLBACK=none
NLU_BASE_URL=http://host.docker.internal:11434/v1
NLU_MODEL=qwen2.5:3b
NLU_API_KEY=
SESSION_MAX_TURNS=10
REFRESH_INTERVAL_MINUTES=60

# Frontend Configuration
FRONTEND_HOST_PORT=3000
# Leave empty: the UI proxies /api to the backend (same origin, no CORS).
NEXT_PUBLIC_API_URL=
